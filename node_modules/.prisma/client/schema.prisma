generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusStatus {
  IDLE // el bus existe pero no está en servicio
  IN_SERVICE // en ruta, emitiendo posición
  FINISHED // viaje finalizado (vuelve a IDLE en la práctica, se deja por trazabilidad)
}

model Bus {
  id        String    @id @default(uuid())
  plate     String    @unique
  route     String
  driver    String?
  status    BusStatus @default(IDLE)
  latitude  Float?
  longitude Float?
  updatedAt DateTime  @updatedAt
  createdAt DateTime  @default(now())

  positions BusPosition[]

  @@map("buses")
}

// Historial de posiciones — soporta trazabilidad (Épica 3) y "detalle de bus" (HU-13)
model BusPosition {
  id         String   @id @default(uuid())
  busId      String
  bus        Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)
  latitude   Float
  longitude  Float
  recordedAt DateTime @default(now())

  @@index([busId, recordedAt])
  @@map("bus_positions")
}
