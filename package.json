{
  "name": "sitpverse-back",
  "version": "0.1.0",
  "description": "Backend de SitpVerse — Modular Monolith + Hexagonal + Realtime (NestJS, Prisma, Redis)",
  "scripts": {
    "build": "nest build && npm run build:seed",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "ts-node prisma/seed.ts",
    "test": "jest",
    "loadtest": "node scripts/load-tests/assistance.js && node scripts/load-tests/fleet.js",
    "loadtest:outbox": "node scripts/load-tests/outbox-recovery.js",
    "seed:reset": "ts-node prisma/seed.ts --reset",
    "loadtest:access": "node scripts/load-tests/access-matrix.js",
    "loadtest:front": "node scripts/load-tests/front-flows.js",
    "postinstall": "prisma generate",
    "start:azure": "node node_modules/prisma/build/index.js migrate deploy && node dist/main.js",
    "build:seed": "tsc prisma/seed.ts --outDir dist/prisma --module commonjs --target ES2021 --esModuleInterop --skipLibCheck",
    "seed:prod": "node dist/prisma/seed.js",
    "loadtest:security": "node scripts/load-tests/security.js",
    "fake-google": "node scripts/load-tests/fake-google.js",
    "loadtest:quality": "node scripts/load-tests/quality.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/platform-socket.io": "^10.4.0",
    "@nestjs/websockets": "^10.4.0",
    "@prisma/client": "^5.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "geoip-country": "^5.0.202611110258",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.1",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^5.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.1.4",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.14.0",
    "c8": "^12.0.0",
    "jest": "^29.7.0",
    "socket.io-client": "^4.8.4",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "coverageDirectory": "../coverage",
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts",
      "!**/test/**",
      "!main.ts",
      "!**/*.module.ts",
      "!shared/testing/**"
    ],
    "coverageReporters": [
      "lcov",
      "text-summary"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "multer": "^2.5.0",
    "body-parser": "^1.20.9",
    "qs": "^6.17.1",
    "lodash": "^4.18.1",
    "file-type": "^21.3.4",
    "ip-address": "^10.7.6"
  }
}
