generator client {
  provider      = "prisma-client-js"
  // "native" = tu máquina (Windows/Mac/Linux); el otro es el motor para Azure App Service (Linux con OpenSSL 3)
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
// IDENTITY — dueño: modules/identity
// ═══════════════════════════════════════════════════════════════════════════

enum UserRole {
  ADMIN
  DRIVER
  MECHANICAL
}

// Usuario mínimo: el login real (JWT) llegará después; hoy se identifica por employeeId.
model User {
  id           String   @id @default(uuid())
  employeeId   String   @unique
  name         String
  role         UserRole
  // Hash bcrypt de la contraseña: NUNCA se guarda ni se devuelve en texto plano.
  passwordHash String
  // Una cuenta desactivada no puede iniciar sesión y su token deja de valer, pero se conserva su historial.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  bus     Bus?              @relation("BusDriver")
  claims  AssistanceClaim[]
  rewards RewardEntry[]

  @@map("users")
}

// ═══════════════════════════════════════════════════════════════════════════
// FLEET — dueño: modules/fleet
// ═══════════════════════════════════════════════════════════════════════════

enum BusStatus {
  IDLE // el bus existe pero no está en servicio
  IN_SERVICE // en ruta, emitiendo posición
  FINISHED // viaje finalizado (vuelve a IDLE en la práctica, se deja por trazabilidad)
}

model Bus {
  id             String    @id @default(uuid())
  plate          String    @unique
  route          String
  // Conductor asignado (un bus ↔ un conductor). Permite autorizar "solo opera SU bus".
  driverId       String?   @unique
  assignedDriver User?     @relation("BusDriver", fields: [driverId], references: [id])
  status         BusStatus @default(IDLE)
  latitude       Float?
  longitude      Float?
  // Ficha del vehículo (registro de flota)
  model          String?
  year           Int?
  operator       String?
  capacity       Int?
  // Referencia legible de dónde está (p. ej. "Calle 26", "Patio Portal Norte")
  locationLabel  String?
  // Cuándo salió el bus en su viaje actual (el mapa y el inicio del conductor muestran "salió 14:32")
  tripStartedAt  DateTime?
  // Foto real del bus (URL devuelta por POST /files/images); la sube/cambia el admin
  photoUrl       String?
  updatedAt      DateTime  @updatedAt
  createdAt      DateTime  @default(now())

  positions BusPosition[]

  @@map("buses")
}

// Historial de posiciones — soporta trazabilidad (Épica 3) y "detalle de bus" (HU-13)
model BusPosition {
  id         String   @id @default(uuid())
  busId      String
  bus        Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)
  latitude   Float
  longitude  Float
  recordedAt DateTime @default(now())

  @@index([busId, recordedAt])
  @@map("bus_positions")
}

// ═══════════════════════════════════════════════════════════════════════════
// ASSISTANCE — dueño: modules/assistance
// Alertas con cupos: el primero en aceptar se queda el cupo (concurrencia).
// ═══════════════════════════════════════════════════════════════════════════

enum IncidentReportStatus {
  REPORTED // el conductor avisó a administración
  HELP_REQUESTED // el admin ya lanzó la alerta de apoyo a conductores
}

enum BlockageStatus {
  OPEN
  RESOLVED
}

enum AlternativeRouteStatus {
  PROPOSED
  ASSIGNED
  ACCEPTED
}

enum TowAssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
}

// Uso 1 (paso 1): un conductor reporta un imprevisto a administración.
model DriverIncident {
  id             String               @id @default(uuid())
  busId          String
  reportedById   String
  // Nombre de quien reportó, copiado al crear el incidente (la pantalla de ayudas lo muestra sin consultar usuarios)
  reportedByName String?
  type           String
  description    String?
  status         IncidentReportStatus @default(REPORTED)
  blockageStatus BlockageStatus       @default(OPEN)
  createdAt      DateTime             @default(now())

  alternativeRoutes AlternativeRoute[]
  towAssignments    TowAssignment[]
  evidence          IncidentEvidence[]

  @@map("driver_incidents")
}

model AlternativeRoute {
  id           String                 @id @default(uuid())
  incidentId   String
  incident     DriverIncident         @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  name         String
  geometry     Json
  status       AlternativeRouteStatus @default(PROPOSED)
  assignedToId String?
  assignedAt   DateTime?
  acceptedAt   DateTime?
  createdAt    DateTime               @default(now())

  @@index([incidentId, status])
  @@index([assignedToId, status])
  @@map("alternative_routes")
}

model TowAssignment {
  id           String              @id @default(uuid())
  incidentId   String
  incident     DriverIncident      @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  busId        String
  towTruck     String
  crew         String
  status       TowAssignmentStatus @default(ASSIGNED)
  assignedById String
  createdAt    DateTime            @default(now())
  completedAt  DateTime?

  @@index([incidentId, status])
  @@map("tow_assignments")
}

// Evidencia fotográfica asociada a un incidente de ruta/inspección.
// El binario se almacena fuera del monolito (URL firmada o URL de almacenamiento).
model IncidentEvidence {
  id           String         @id @default(uuid())
  incidentId   String
  incident     DriverIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  url          String
  caption      String?
  capturedAt   DateTime?
  uploadedById String
  createdAt    DateTime       @default(now())

  @@index([incidentId, createdAt])
  @@map("incident_evidence")
}

enum AssistanceKind {
  DRIVER_SUPPORT // uso 1: N conductores/buses de apoyo
  REPAIR // uso 2: 1 mecánico para reparar un bus
}

enum CallStatus {
  OPEN
  FILLED // todos los cupos tomados: la notificación se deshabilita
  COMPLETED
}

// Alerta "reclamable". `slots` = cupos; `claimedCount` = reclamos ACTIVOS, se modifica de forma atómica.
// En la migración hay un CHECK (claimedCount <= slots) y un índice único parcial
// que impide dos reparaciones abiertas para el mismo bus.
model AssistanceCall {
  id           String         @id @default(uuid())
  kind         AssistanceKind
  incidentId   String?
  busId        String
  slots        Int
  claimedCount Int            @default(0)
  rewardPoints Int
  status       CallStatus     @default(OPEN)
  createdById  String
  description  String?
  createdAt    DateTime       @default(now())
  completedAt  DateTime?

  claims       AssistanceClaim[]
  repairReport RepairReport?

  @@index([kind, status])
  @@map("assistance_calls")
}

enum ClaimStatus {
  ACTIVE
  CANCELLED // el admin lo canceló (no llegó a tiempo): libera el cupo
}

model AssistanceClaim {
  id            String         @id @default(uuid())
  callId        String
  call          AssistanceCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  status        ClaimStatus    @default(ACTIVE)
  // Bus desde el que se acude (conductor de apoyo); el admin lo sigue en el mapa en tiempo real.
  busId         String?
  // Plazo máximo para llegar (aceptación + ASSISTANCE_ARRIVAL_MINUTES). Si vence, el admin cancela y reenvía.
  arriveBy      DateTime
  cancelledAt   DateTime?
  cancelledById String?
  createdAt     DateTime       @default(now())

  // Un usuario solo puede tomar UN cupo por alerta; si lo cancelan no puede retomarlo.
  @@unique([callId, userId])
  @@index([callId, status])
  @@map("assistance_claims")
}

// Libro de puntos: una fila por (usuario, alerta). El UNIQUE impide pagar dos veces la misma alerta.
// El saldo se calcula sumando; así hay auditoría y no se mezcla con la tabla de usuarios (identity).
model RewardEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  callId    String
  points    Int
  createdAt DateTime @default(now())

  @@unique([userId, callId])
  @@map("reward_entries")
}

// ═══════════════════════════════════════════════════════════════════════════
// SHARED — Transactional Outbox
// Los eventos que NO se pueden perder se escriben aquí en la MISMA transacción que
// el cambio de estado; un relay los publica en Redis Streams (ver shared/infrastructure/outbox).
// ═══════════════════════════════════════════════════════════════════════════

model OutboxEvent {
  id          BigInt    @id @default(autoincrement()) // orden global; viaja como `seq`
  eventId     String    @unique // idempotencia: el cliente descarta duplicados (entrega at-least-once)
  channel     String // stream de Redis destino
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  @@map("outbox_events")
}

// Informe del mecánico sobre una reparación (alerta REPAIR). Se guarda como borrador cuantas veces
// quiera y se cierra al finalizar: `completedAt` lo marca como definitivo y ya no admite cambios.
model RepairReport {
  id            String         @id @default(uuid())
  callId        String         @unique
  call          AssistanceCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  mechanicId    String
  mechanicName  String
  damages       String         @default("")
  replacedParts String         @default("")
  expenses      Json           @default("[]") // [{ concepto, valor }]
  busPhotos     Json           @default("[]") // URLs de /uploads
  partPhotos    Json           @default("[]")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  completedAt   DateTime?

  @@index([mechanicId, completedAt])
  @@map("repair_reports")
}

// ═══════════════════════════════════════════════════════════════════════════
// INSPECTIONS — dueño: modules/inspections
// Inspección previa al viaje con fotos. Inmutable: no se edita ni se borra (trazabilidad).
// ═══════════════════════════════════════════════════════════════════════════

model BusInspection {
  id            String   @id @default(uuid())
  busId         String
  inspectorId   String
  inspectorName String
  inspectorRole UserRole
  note          String
  comment       String?
  photos        Json     @default("[]") // URLs de /uploads
  createdAt     DateTime @default(now())

  @@index([busId, createdAt])
  @@index([inspectorId, createdAt])
  @@map("bus_inspections")
}
