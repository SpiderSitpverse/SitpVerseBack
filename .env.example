# Copia este archivo a `.env` y ajusta lo que necesites:  cp .env.example .env

PORT=3000

# Origen(es) permitido(s) para CORS y WebSocket, separados por coma (Vite corre en 5173)
CORS_ORIGIN=http://localhost:5173

# ── Infraestructura (docker compose up -d) ──────────────────────────────────
# Si el puerto 5432 ya lo usa otro Postgres, cambia POSTGRES_PORT (p. ej. 5433)
# y usa el mismo puerto en DATABASE_URL.
POSTGRES_PORT=5432
DATABASE_URL="postgresql://sitpverse:sitpverse@localhost:5432/sitpverse?schema=public"

REDIS_HOST=localhost
REDIS_PORT=6379
# Redis en la nube (Azure Managed Redis): clave de acceso y conexión cifrada. En local (docker) déjalos vacíos.
REDIS_PASSWORD=
REDIS_TLS=false

# ── Flota ───────────────────────────────────────────────────────────────────
# external  = simulador apagado (RECOMENDADO): la posición la manda el GPS del conductor o la API real
# simulated = solo para demos SIN dispositivos: mueve cada bus en servicio ±110 m cada 3 s y se pisa con el
#             GPS real (el bus "camina" estando quieto). No lo uses si el conductor comparte su ubicación.
FLEET_FEED_MODE=external
FLEET_SIMULATION_INTERVAL_MS=3000

# ── Asistencia ──────────────────────────────────────────────────────────────
# Puntos que cobra un mecánico por bus reparado (si el reporte no indica otro valor)
REPAIR_BONUS_POINTS=50
# Minutos que tiene quien acepta una alerta para llegar. Si vence, el admin cancela y reenvía.
ASSISTANCE_ARRIVAL_MINUTES=20

# ── Outbox (eventos que no se pueden perder) ────────────────────────────────
# Cada cuánto (ms) el relay revisa eventos pendientes; además se despierta al confirmar cada cambio.
OUTBOX_POLL_MS=250

# ── Autenticación (Google OpenID Connect + token de sesión JWT) ─────────────
# OBLIGATORIO en producción (mínimo 32 caracteres); en desarrollo hay un valor por defecto.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Vida del token de acceso (formato de jsonwebtoken: 8h, 30m, 1d)
JWT_EXPIRES_IN=8h
# Client ID de Google OAuth de SitpVerse (console.cloud.google.com > APIs y servicios > Credenciales). OBLIGATORIO en
# producción: es la audiencia (`aud`) que deben traer los ID tokens. No lleva secreto.
GOOGLE_CLIENT_ID=
# Correos con los que entran los usuarios de demostración 1001 (ADMIN), 2001 (DRIVER) y 3001 (MECHANICAL) al correr `npm run seed`.
# Los demás quedan con un correo ficticio (<empleado>@sitpverse.local) que nadie puede usar para entrar.
SEED_ADMIN_EMAIL=
SEED_DRIVER_EMAIL=
SEED_MECHANIC_EMAIL=
# SOLO para pruebas (el servidor no arranca en producción si está definida): apunta a un Google falso.
# GOOGLE_JWKS_URI=http://127.0.0.1:4010/certs

# ── Fotos de evidencia ──────────────────────────────────────────────────────
# Carpeta donde se guardan las fotos subidas (en Azure App Service, dentro de /home para que persista)
UPLOADS_DIR=uploads

# ── Límite de peticiones de inicio de sesión ───────────────────────────────
# Peticiones por minuto a /auth/nonce y /auth/google desde una misma IP; pasado el límite: 429 con Retry-After.
LOGIN_RATE_PER_MINUTE=10

# ── Retención de los registros de trazabilidad ──────────────────────────────
# request_log (TODAS las peticiones: mucho volumen) y audit_log (acciones críticas: poco volumen). La base impone un mínimo
# (7 y 365 días): no se puede configurar menos. La purga corre cada 6 h, en lotes y con candado (una sola instancia).
REQUEST_LOG_RETENTION_DAYS=14
AUDIT_RETENTION_DAYS=730

# ── Producción ──────────────────────────────────────────────────────────────
# Con NODE_ENV=production la app NO arranca sin: JWT_SECRET (≥32 caracteres), CORS_ORIGIN (la URL del front,
# nunca "*"), DATABASE_URL y un REDIS_HOST que no sea localhost.
# NODE_ENV=production

